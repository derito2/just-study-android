# Android / Gradle
*.iml
.gradle/
/build/
**/build/
/captures
.externalNativeBuild
.cxx
.kotlin/
*.apk
*.aab
.DS_Store

# Android Studio
/.idea/caches
/.idea/libraries
/.idea/modules.xml
/.idea/workspace.xml
/.idea/navEditor.xml
/.idea/assetWizardSettings.xml
/.idea/deploymentTargetSelector.xml
