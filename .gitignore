# Local config and secrets (never commit)
local.properties
*.jks
*.keystore
.env

# AI models
*.gguf
*.tflite
*.litertlm
models/

# Private golden data (user's notes)
golden/private/

# CodeGraph database (keeps only .codegraph/.gitignore)
.codegraph/*
!.codegraph/.gitignore

# PoC outputs and backups (user's data)
build/poc/
*.jsbackup.zip
# Synthetic backups (test PDFs, no personal data) that the tests need:
!golden/db/*.jsbackup.zip
!core/data/src/androidTest/assets/backup/*.jsbackup.zip

# Python tools
__pycache__/
.pytest_cache/
.ruff_cache/

# Personal photos and the launch pictures drawn from them: only on the owner's Mac, never on GitHub.
# The app shows them when they exist (ui/splash/Splash.kt); CI builds with the three flash pictures only.
picsIcons/
app/src/main/res/drawable-nodpi/splash_photo_*.webp
tools/design/splash_scenes.py

# QA round reports: they quote the owner's notes, never on GitHub
/qa/
